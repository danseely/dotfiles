# Tool-managed installs — restored by setup, not dotfiles content
.oh-my-zsh/
.fzf.zsh

# iTerm2 prefs are decoupled from this repo (curated export only).
# See NOTES.md / Pass 0. The live plist is per-machine and not tracked.
.iterm/

# Karabiner auto-generated backups (not configuration)
karabiner/automatic_backups/

# Claude Code project-local settings (per-machine permissions/state)
.claude/*.local.json

# zsh compinit cache files — hostname-suffixed, regenerated on each shell
# start. They appear in zsh/ when verifying via ZDOTDIR=zsh/.
zsh/.zcompdump*
